# Folder with age_*.keras, gan_generator.keras and metrics.json
MODELS_DIR=../models
# Comma-separated origins allowed to call the API from a browser (not needed behind the nginx proxy)
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=5
# cnn | cnn_gan | efficientnet — empty = best model by validation MAE
DEFAULT_MODEL=
LOG_LEVEL=INFO
